{
  "rules": {
    ".read": false,
    ".write": false,
    "ementas": {
      ".read": "auth != null",
      "$periodo": {
        ".write": "auth != null",
        "$dia": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        }
      }
    },
    "reviews": {
      ".read": "auth != null",
      "$periodo": {
        "$dia": {
          "$entryId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['type', 'ts']) && ((newData.child('type').val() == 'review' && newData.child('stars').isNumber() && newData.child('stars').val() >= 1 && newData.child('stars').val() <= 5) || (newData.child('type').val() == 'recommendation' && !newData.hasChild('stars') && newData.child('text').isString() && newData.child('text').val().length > 0))",
            "type": {
              ".validate": "newData.isString() && (newData.val() == 'review' || newData.val() == 'recommendation')"
            },
            "stars": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length <= 500"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name', 'householdSize', 'ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "householdSize": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "attendance": {
      "$periodo": {
        ".read": "auth != null",
        "$dia": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid",
            ".validate": "newData.hasChildren(['count', 'ts'])",
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "cookOverrides": {
      ".read": "auth != null",
      "$dia": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['uid', 'by', 'ts'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "prevUid": {
          ".validate": "newData.isString()"
        },
        "by": {
          ".validate": "newData.isString()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "shoppingLists": {
      ".read": "auth != null",
      "$listId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['name', 'ts'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "createdBy": {
          ".validate": "newData.isString()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "items": {
          "$itemId": {
            ".validate": "newData.hasChildren(['name', 'done', 'ts'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
            },
            "done": {
              ".validate": "newData.isBoolean()"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "auth != null",
      "period": {
        ".validate": "newData.hasChildren(['startDate', 'endDate', 'ts'])",
        "startDate": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "endDate": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      "cooks": {
        ".validate": "newData.hasChildren(['order', 'ts'])",
        "order": {
          "$index": {
            ".validate": "newData.isString()"
          }
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
